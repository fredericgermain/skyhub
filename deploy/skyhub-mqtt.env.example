# Sky Hub
SKYHUB_URL=http://192.168.0.1/
SKYHUB_USER=admin
SKYHUB_PASSWORD=change-me
SKYHUB_TIMEOUT=30s

# MQTT
MQTT_BROKER=tcp://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=skyhub-mqtt
MQTT_BASE_TOPIC=skyhub

# Home Assistant discovery prefix; set empty to disable
HA_DISCOVERY_PREFIX=homeassistant

# Polling
STATS_INTERVAL=10s
SLOW_INTERVAL=60s
INFO_INTERVAL=6h
DEVICE_TTL=5m
SKYHUB_DEBUG=false
