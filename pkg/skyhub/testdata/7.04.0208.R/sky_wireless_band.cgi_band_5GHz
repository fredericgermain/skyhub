function check_if_allow_submit()
{
	var good_words_SSID = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !#$%&'()*+,-./:;=?@[\\]^_`{|}~";
	if (if_allow_submit==false)
		return ;
    var ssid = document.forms[0].wlSsid.value;
    var space=" ";
    if( (ssid.indexOf(space)==0) || (ssid.lastIndexOf(space)==ssid.length-1) ) {
        alertR("SSID cannot have space character at beginning or end");
        return false;
    }

        if (xSSpatternExists(decodeHtml(ssid)))
        {
           alertR("Invalid SSID name");
           return;
        }

	if (check_goodwords(ssid, good_words_SSID))
	{
        return true;
	}
	else
	{
		//return false;
		alertR("SSID contains characters which are not allowed. Valid special characters are SPACE!#$%&'()*+,-./:;=?@[\\]^_`{|}~");
		return;
	}
	
		
		
}

function showhide(element, sh)
{
  var status;
    if (sh == 1) {
        status = "inline";
    }
    else {
        status = "none"
    }

    if (document.getElementById)
    {
	// standard
	document.getElementById(element).style.display = status;
    }
    else if (document.all)
    {
	// old IE
	document.all[element].style.display = status;
    }
    else if (document.layers)
    {
	// Netscape 4
	document.layers[element].display = status;
    }
}
